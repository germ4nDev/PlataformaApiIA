# 1. Dependencias
node_modules/
jspm_packages/
.pnp.*

# 2. Datos Crudos y Almacenamiento Local (Archivos Pesados)
data/
uploads/

# 3. Variables de Entorno y Secretos (Seguridad)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# 4. Logs y Reportes
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# 5. Archivos de Runtime y Pruebas (Coverage)
pids/
*.pid
*.seed
*.pid.lock
lib-cov/
coverage/
*.lcov
.nyc_output/

# 6. Compilaciones y Caché de Herramientas
build/Release/
dist/
.cache/
*.tsbuildinfo
.npm/
.eslintcache
.stylelintcache

# 7. Archivos del Sistema Operativo
.DS_Store
Thumbs.db