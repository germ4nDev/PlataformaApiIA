<!-- Archivo: src/templates/emails/nueva-clave.hbs -->
<div
    style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #ddd; border-radius: 8px; overflow: hidden;">
    <div style="background-color: #2c3e50; color: white; padding: 20px; text-align: center;">
        <h2>Plataforma 2.0</h2>
    </div>
    <div style="padding: 30px; color: #333;">
        <p>Hola <strong>{{nombre}}</strong>,</p>
        <p>Se ha generado una nueva credencial para tu cuenta en la plataforma.</p>
        <div
            style="background-color: #f8f9fa; padding: 15px; text-align: center; font-size: 20px; letter-spacing: 2px; margin: 20px 0; border-radius: 5px;">
            <strong>{{clave}}</strong>
        </div>
        <p>Por razones de seguridad, te recomendamos cambiar esta clave al ingresar por primera vez.</p>
    </div>
    <div style="background-color: #f1f1f1; padding: 15px; text-align: center; font-size: 12px; color: #777;">
        © 2026 Plataforma QPLUS. Todos los derechos reservados.
    </div>
</div>